<?xml version="1.0"?>
<package format="3">
  <name>pnc_tactile_visualizer</name>
  <version>0.1.0</version>
  <description>Frame-attached 47-zone PNC tactile heatmap for Foxglove.</description>
  <maintainer email="support@example.com">PNC Hand maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>inspire_rh56e2_hand_description</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
