{
  "name": "foxglove-dexhand-panels",
  "displayName": "Dexterous Hand Panels",
  "description": "Foxglove panels for Inspire hand commands and name-keyed 54-channel PNC tactile diagnostics with isolated simulation injection.",
  "publisher": "Renesas-UX-SST",
  "homepage": "",
  "version": "1.1.2",
  "license": "Apache-2.0",
  "main": "./dist/extension.js",
  "keywords": [
    "foxglove",
    "ros2",
    "pnc",
    "tactile-hand"
  ],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@foxglove/extension": "^2.51.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "create-foxglove-extension": "^1.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
